# Normalise line endings in the repository
* text=auto

# Documentation - LF everywhere
*.md   text eol=lf

# PowerShell - CRLF, native for Windows tooling
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Evidence and binaries - never modify
*.png  binary
*.jpg  binary
*.pdf  binary